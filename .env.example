# Copy file này thành .env cho local dev (KHÔNG commit .env).
# Trên AWS, các biến này được set qua User Data của Launch Template
# (xem CLAUDE.md repo cmp-guestbook-doc) — KHÔNG dùng file .env trên EC2.

# Local dev dùng 3000 (không cần sudo). Production set PORT=80.
PORT=3000

# Khớp docker-compose.yml — MySQL local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=guestbook
DB_PASS=guestbook_password
DB_NAME=guestbook

# Bucket S3 dev thật trên AWS (tạo thủ công, KHÔNG dùng bucket của
# CloudFormation lab), đã bật CORS cho origin http://localhost:3000
S3_BUCKET=local-guestbook-s3-{your-aws-account-id}
AWS_REGION=us-east-1

# Local dev: nếu chưa cấu hình ~/.aws/credentials thì bỏ comment 2 dòng
# dưới. Trên EC2 KHÔNG cần (dùng Instance Profile).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
